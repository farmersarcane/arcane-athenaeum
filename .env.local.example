# Neon — this project's own isolated Postgres project. Do not reuse the
# Makers Arcane or Farmers Arcane projects.
#
# Two connection strings from the Neon console, both required, for two
# different Postgres roles:
#
# DATABASE_URL: the project owner role's connection string (e.g.
# `neondb_owner`). Full privileges. The app never connects with this one at
# runtime — it's for applying db/001_schema.sql (and any future migrations)
# by hand in the Neon SQL editor or psql. Apply to a dev branch first, verify,
# then prod.
DATABASE_URL=
#
# DATABASE_AUTHENTICATED_URL: the passwordless `authenticated` role's
# connection string. This is created for you once you add Clerk as an
# authorization provider for the project under Neon's RLS / "Authorize"
# settings (paste in Clerk's JWKS URL there). Every request the app makes at
# runtime uses this one, carrying the signed-in user's Clerk session token —
# Postgres row-level security (auth.user_id() in db/001_schema.sql), not
# application code, is what decides which rows a given request can see.
DATABASE_AUTHENTICATED_URL=

# Clerk — hosted sign-in/sign-up. Free tier (50,000 monthly active users, as
# of Feb 2026 pricing) comfortably covers this app at its single-user
# portfolio scale. Both keys are from the Clerk dashboard's API Keys page
# after creating an application there.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's hosted components send users. These match the routes this
# app actually has (app/(auth)/sign-in, app/(auth)/sign-up) and where a
# signed-in user should land.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library

# Google Books. Treat this as REQUIRED, not optional: without a key, requests
# fall back to one shared anonymous Google project whose daily quota is
# routinely already exhausted, and every lookup returns 429. Verified against
# the live API on 2026-08-31. Server-side only — never expose it to the browser.
GOOGLE_BOOKS_API_KEY=
